{
  "name": "@aponiajs/example-inertia-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build ./src/main.ts --outdir ./dist --target bun && bun build ./src/client.ts --outdir ./dist/client --target browser",
    "test": "bun test",
    "test:e2e": "bun test ./test/inertia-vue.e2e-spec.ts",
    "check": "vp check"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/core": "workspace:*",
    "@aponiajs/mvc": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@inertiajs/vue3": "3.11.0",
    "elysia": "2.0.0-rc.4",
    "vue": "3.5.45"
  }
}

{
  "name": "@aponiajs/example-inertia-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build ./src/main.ts --outdir ./dist --target bun && bun build ./src/client.tsx --outdir ./dist/client --target browser",
    "test": "bun test",
    "test:e2e": "bun test ./test/inertia-react.e2e-spec.ts",
    "check": "vp check"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/core": "workspace:*",
    "@aponiajs/mvc": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@inertiajs/react": "3.11.0",
    "elysia": "2.0.0-rc.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}

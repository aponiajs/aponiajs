{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["bun", "react", "react-dom"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@aponiajs/common": ["../../packages/common/src/index.ts"],
      "@aponiajs/core": ["../../packages/core/src/index.ts"],
      "@aponiajs/mvc": ["../../packages/mvc/src/index.ts"],
      "@aponiajs/platform-elysia": ["../../packages/platform-elysia/src/index.ts"]
    }
  }
}

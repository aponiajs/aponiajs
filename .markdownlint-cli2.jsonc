{
  "globs": [
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "ROADMAP.md",
    "docs/**/*.md",
    "packages/*/README.md",
    "examples/**/*.md",
  ],
  "ignores": [
    "CHANGELOG.md",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/GEMINI.md",
    "docs-site/**",
    "**/node_modules/**",
  ],
  "config": {
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD026": false,
    "MD029": { "style": "ordered" },
    "MD033": false,
    "MD036": false,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    "MD051": false,
    "MD060": false,
  },
}

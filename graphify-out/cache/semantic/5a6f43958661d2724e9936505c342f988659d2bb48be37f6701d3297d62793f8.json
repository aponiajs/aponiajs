    {
      "id": "packages_rate_limit_agents_ratelimitguard",
      "label": "RateLimitGuard and @RateLimit()",
      "file_type": "concept",
      "rationale": "Sets RateLimit-* headers before deciding and adds Retry-After on refusal, returning 429 Problem Details rather than 403.",
      "source_file": "packages/rate-limit/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_rate_limit_agents_ratelimitservice",
      "label": "RateLimitService",
      "file_type": "concept",
      "rationale": "Increments request bucket exactly once per request; guard never retries or double-increments on refusal.",
      "source_file": "packages/rate-limit/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_rate_limit_agents_memoryratelimitstore",
      "label": "RateLimitStore and MemoryRateLimitStore",
      "file_type": "concept",
      "rationale": "Requires positive integer maxKeys and evicts oldest insertion to avoid unbounded maps; clock is injectable for deterministic tests.",
      "source_file": "packages/rate-limit/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_rate_limit_agents_default_route_key",
      "label": "Default Route-Identity Rate Limit Key",
      "file_type": "rationale",
      "rationale": "Defaults to route identity rather than client-supplied headers (X-Forwarded-For, X-Real-IP) so trusted proxy extraction is an explicit application key-function decision.",

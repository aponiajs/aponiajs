      "id": "packages_session_agents_id_only_cookie",
      "label": "HMAC-Signed Id-Only HttpOnly Session Cookie",
      "file_type": "rationale",
      "rationale": "Session cookies store only an HMAC-signed session id verified with timing-safe comparison while data remains in SessionStore; middleware installs cookie writers before the handler so mutations write immediately even on platforms whose middleware chain does not wrap the handler.",
      "source_file": "packages/session/AGENTS.md",

    {
      "id": "packages_session_agents_regenerate_fixation",
      "label": "Session Fixation Defence via regenerate()",
      "file_type": "rationale",
      "rationale": "regenerate() deletes the old session id before writing the new one so an id issued prior to login or privilege escalation cannot remain valid.",

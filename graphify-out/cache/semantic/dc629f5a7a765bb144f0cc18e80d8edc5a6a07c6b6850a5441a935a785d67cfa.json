      "id": "packages_queue_agents_retry_deadletter_policy",
      "label": "Deterministic Retry, Timeout, Idempotency, and Bounded Dead-Letter Policy",
      "file_type": "rationale",
      "rationale": "Uses injectable clock/timer for deterministic backoffMs * 2^(attempts - 1), cooperative AbortController timeouts (QUEUE_JOB_TIMEOUT), bounded maxDeadLetters eviction, and runOutsideAsyncContexts isolation.",
      "source_file": "packages/queue/AGENTS.md",

    {
      "id": "packages_queue_agents_outboxservice",
      "label": "OutboxService and SqliteOutboxStore",
      "file_type": "concept",
      "rationale": "Delivers recorded messages in order and stops at the first sink rejection (keeping it at front) so the next flush retries in order.",
      "source_file": "packages/queue/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_queue_agents_backlog_not_broker",
      "label": "Durable Backlog vs Distributed Broker Boundary",
      "file_type": "rationale",
      "rationale": "Supplied QueueStore persists job backlog across restarts (hydrating running jobs as pending and flushing tracked writes) for one consumer, rather than acting as a cross-process claiming broker.",
      "source_file": "packages/queue/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_queue_agents_shutdown_sequence",
      "label": "Queue Shutdown Sequence (drain -> close -> flush)",
      "file_type": "rationale",
      "rationale": "onModuleDestroy drains due jobs first, then aborts in-flight work via close(), and finally flushes tracked store writes.",
      "source_file": "packages/queue/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_queue_agents_processor_surface",
      "label": "Processor Surface (@Processor, WorkerHost, @InjectQueue, JOB_REF, ProcessorExplorer)",
      "file_type": "concept",
      "rationale": "Maps BullMQ-shaped processor names (AponiaQueue_<name>) onto in-process QueueService handlers without broker worker subscriptions or lock renewals.",

      "id": "packages_platform_core_agents_collectlifecyclecalls",
      "label": "collectLifecycleCalls",
      "file_type": "code",
      "rationale": "Orders lifecycle hooks by module distance (deepest imports and globals first, root last; reversed with reverseModules on shutdown) while excluding request-scoped and transient instances.",

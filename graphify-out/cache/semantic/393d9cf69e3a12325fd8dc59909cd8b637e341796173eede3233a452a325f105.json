      "id": "packages_platform_core_agents_aponia_http_application",
      "label": "AponiaHttpApplication & AponiaApplicationSurfaceConfig",
      "file_type": "concept",
      "rationale": "Provides the shared Nest application surface across Elysia, Hono, and H3 via mergeApplicationSurfaceOptions; refuses post-init surface mutations with INVALID_CONFIGURATION.",

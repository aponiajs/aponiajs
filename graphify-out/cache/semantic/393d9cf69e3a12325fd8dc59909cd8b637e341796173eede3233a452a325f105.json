      "id": "packages_platform_core_agents_run_order_contract",
      "label": "Shared Enhancer Run Order Contract",
      "file_type": "rationale",
      "rationale": "Fixes runtime execution order across platforms: middleware -> guards and interceptor before halves -> handler -> interceptor after halves reversed -> filters most-specific-first.",
      "source_file": "packages/platform-core/AGENTS.md",
      "source_location": null,

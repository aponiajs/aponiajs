      "id": "packages_schematics_agents_schematic_factory_contract",
      "label": "Plain-Function Schematic Factory Contract",
      "file_type": "rationale",
      "rationale": "Defines factories as (options) => { files } without an @angular-devkit/schematics dependency so publishing or consuming third-party collections requires no Angular DevKit runtime.",
      "source_file": "packages/schematics/AGENTS.md",
      "source_location": null,

    {
      "id": "packages_schematics_agents_tmpl_exclusion",
      "label": "Template .tmpl Suffix Exclusion",
      "file_type": "rationale",
      "rationale": "Every template carries a .tmpl suffix and src/lib/**/files/** is excluded from check lanes so <%= ... %> placeholders never reach tsc, Oxlint, or Oxfmt.",
      "source_file": "packages/schematics/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_schematics_agents_upgrade_schematic",
      "label": "upgrade / update Schematic",
      "file_type": "concept",
      "rationale": "Plans no files because @aponiajs/cli owns manifest rewriting and package installation using workspace version resolution; the factory exists so the update alias resolves uniformly.",

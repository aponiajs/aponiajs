    },
    {
      "id": "scratch_nestjs_dx_parity_research_performance_global_onrequest_bottleneck",
      "label": "E6: Global onRequest/onAfterResponse Disabling Bun Static Promotion",
      "file_type": "concept",
      "rationale": "Registering global onRequest hooks forces eager Context allocation and materializeSetHeaders before route matching and disables Bun.serve native static response promotion.",

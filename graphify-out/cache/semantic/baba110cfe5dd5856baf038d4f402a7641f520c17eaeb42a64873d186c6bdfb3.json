      "id": "scratch_nestjs_dx_parity_research_performance_piped_route_async_bottleneck",
      "label": "E5: Piped Route Async Closure & Context Boxing",
      "file_type": "concept",
      "rationale": "Piped routes fall back to async (context) calling extractParameterValue(context, ...), breaking sucrose inference and making POST /piped 30.5% slower than schema-validated POST /json.",
      "source_file": ".scratch/nestjs-dx-parity/research-performance.md",
      "source_location": "lines 120, 169",
      "source_url": null,

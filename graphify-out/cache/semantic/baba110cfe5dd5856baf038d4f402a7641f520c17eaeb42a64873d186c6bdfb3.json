      "author": null,
      "contributor": null
    },
    {
      "id": "scratch_nestjs_dx_parity_research_performance_async_hooks_bottleneck",
      "label": "E4: Always-Async beforeHandle/afterHandle & Double Fork",
      "file_type": "concept",
      "rationale": "Declaring beforeHandle and afterHandle unconditionally async forces tail=false and Promise allocation on sync guards/interceptors (-27.0% guarded, -47.0% intercepted).",
      "source_file": ".scratch/nestjs-dx-parity/research-performance.md",
      "source_location": "lines 119, 166-168",

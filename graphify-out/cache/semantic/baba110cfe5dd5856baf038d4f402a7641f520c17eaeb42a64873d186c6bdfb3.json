    {
      "id": "scratch_nestjs_dx_parity_research_performance_per_route_error_filter_bottleneck",
      "label": "E2: Unconditional Per-Route Default Error Filter",
      "file_type": "concept",
      "rationale": "Attaching defaultFilter to every route's error hook sets hasErrorHook=true in Elysia, forcing responseMode='set' instead of 'compact'.",

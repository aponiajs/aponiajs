    {
      "id": "scratch_nestjs_dx_parity_research_performance_handle_promise_wrapper_bottleneck",
      "label": "E3: AponiaApplication.handle() Promise Wrapper",
      "file_type": "concept",
      "rationale": "Wrapping nativeApplication.handle with a .then check and .finally callback even when releaseRequest is undefined reduces bare route throughput by 16.0% (2.36M vs 2.81M ops/s).",
      "source_file": ".scratch/nestjs-dx-parity/research-performance.md",
      "source_location": "lines 118, 228",
      "source_url": null,

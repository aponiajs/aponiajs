    {
      "id": "packages_store_redis_agents_scan_unlink",
      "label": "SCAN and UNLINK Cleanup Pattern",
      "file_type": "rationale",
      "rationale": "clear() and family cleanup page with SCAN and delete with UNLINK when available, falling back to KEYS/DEL only for minimal clients so shared Redis instances are never blocked by KEYS.",
      "source_file": "packages/store-redis/AGENTS.md",
      "source_location": null,
      "source_url": null,

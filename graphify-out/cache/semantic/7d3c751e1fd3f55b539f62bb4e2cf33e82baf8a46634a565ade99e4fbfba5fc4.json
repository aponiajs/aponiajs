    },
    {
      "id": "packages_store_redis_agents_shared_client_close",
      "label": "Idempotent Shared Redis Client Release",
      "file_type": "rationale",
      "rationale": "Every store exposes idempotent close() and Symbol.asyncDispose; releases its client unless closeClient: false, and quits a shared client exactly once on the first close().",

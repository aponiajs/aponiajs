      "id": "docs_learn_13_enhancers_exception_filter",
      "label": "ExceptionFilter (@Catch)",
      "file_type": "concept",
      "rationale": "Compiles into a route-local error array matched by instanceof most-specific-first; first non-null/non-undefined answer wins.",

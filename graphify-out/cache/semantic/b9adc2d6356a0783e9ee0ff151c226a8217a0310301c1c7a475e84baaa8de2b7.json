      "id": "scripts_agents_version_to_channel_mapping",
      "label": "Version-Derived Distribution Channel Mapping",
      "file_type": "rationale",
      "rationale": "npm distribution tags are derived strictly from SemVer (stable->latest, -alpha.N->alpha, -beta.N->beta, -rc.N->rc, -canary.*->canary) and mapped 1:1 to persistent release branches so prereleases can never take latest.",
      "source_file": "scripts/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "scripts_agents_release_script_entry_pattern",
      "label": "Testable Release Script Entry Pattern",
      "file_type": "rationale",
      "rationale": "Release scripts keep if (import.meta.main) as a single call to an exported returning function so scripts/*.spec.ts covers the entry body directly while reserving subprocess tests for exit code and terminal output.",
      "source_file": "scripts/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "scripts_agents_github_output_append",
      "label": "Append-Only GITHUB_OUTPUT Writing",
      "file_type": "rationale",
      "rationale": "Release scripts append to GITHUB_OUTPUT directly instead of read-then-rewrite so missing or unwritable directories fail instead of being silently ignored.",

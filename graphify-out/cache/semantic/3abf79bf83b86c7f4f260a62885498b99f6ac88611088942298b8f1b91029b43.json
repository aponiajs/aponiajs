    {
      "id": "packages_openapi_agents_path_typeerror_vs_config_error",
      "label": "Mount Path TypeError vs Configuration AponiaError",
      "file_type": "rationale",
      "rationale": "Non-absolute mount paths are source-level programming mistakes (TypeError during registration), whereas invalid configuration values throw AponiaError(INVALID_CONFIGURATION_VALUE) with total issue reporting.",

    {
      "id": "packages_openapi_agents_single_registration_invariant",
      "label": "One OpenApiModule Registration Invariant",
      "file_type": "rationale",
      "rationale": "The module provides and exports the configuration token itself to avoid a module cycle; two registrations with distinct keys cause AMBIGUOUS_PROVIDER on read-back, while shared keys raise DUPLICATE_MODULE.",
      "source_file": "packages/openapi/AGENTS.md",

    {
      "id": "packages_graphql_agents_no_schema_boundary",
      "label": "No-Schema Adapter Boundary",
      "file_type": "rationale",
      "rationale": "The package only contributes module registration, validated path configuration, and a neutral HttpPolicy delegating to graphql-yoga; it intentionally avoids schema-first or code-first decorators.",
      "source_file": "packages/graphql/AGENTS.md",
      "source_location": "line 25",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_graphql_agents_path_pair_invariant",
      "label": "GraphQL Path Pair Invariant",
      "file_type": "rationale",
      "rationale": "Yoga requires graphqlEndpoint while the policy route matches path; setting only one causes 404 responses, so buildGraphQLPolicy sets both from the single validated path field.",
      "source_file": "packages/graphql/AGENTS.md",
      "source_location": "line 36",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_graphql_agents_request_policy_precedence",
      "label": "Request Policy Precedence Before Routing",
      "file_type": "rationale",
      "rationale": "Serving GraphQL via HttpPolicy executes before controller routing across platforms and methods, preventing DUPLICATE_ROUTE errors while excluding controller enhancers such as guards and filters.",
      "source_file": "packages/graphql/AGENTS.md",
      "source_location": "line 55",

    {
      "id": "packages_platform_elysia_agents_inspection",
      "label": "inspectAponiaApplication",
      "file_type": "concept",
      "rationale": "Projects frozen, JSON-serializable metadata directly from bootstrap lowering without constructing providers or controllers.",

    },
    {
      "id": "packages_platform_elysia_agents_application_diagnostics",
      "label": "Non-Enumerable Application Seams (Diagnostics, Container, Store)",
      "file_type": "concept",
      "rationale": "Uses non-enumerable, non-writable symbol properties because Elysia walks instance keys during composition.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,

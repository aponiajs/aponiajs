    {
      "id": "packages_platform_elysia_agents_bootstrap_order",
      "label": "Elysia Bootstrap Order",
      "file_type": "rationale",
      "rationale": "Load-bearing sequence ensures plugins, providers, controllers, onModuleInit, async plugin composition, WebSocket gateways, and onApplicationBootstrap run in deterministic dependency order before listening.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_createapplicationcontext",
      "label": "AponiaFactory.createApplicationContext",
      "file_type": "concept",
      "rationale": "Boots provider graph without HTTP listener or controller instantiation for worker contexts.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_version_negotiation",
      "label": "API Versioning and Fetch-Boundary Negotiation",
      "file_type": "rationale",
      "rationale": "Mounts /vN routes once and rewrites header, media-type, or custom-extracted requests at the fetch boundary to /vN rather than creating duplicate route mounts, answering 400 API_VERSION_NOT_FOUND for undeclared versions.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_strictcodegen",
      "label": "strictCodegen Policy",
      "file_type": "concept",
      "rationale": "Opt-in policy refusing routes without a generated invoker via UNSAFE_CODE_GENERATION while keeping false as default for descriptor-less apps.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_lazymoduleloader",
      "label": "LazyModuleLoader and LazyModuleRef",
      "file_type": "concept",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_application_plugins_option",
      "label": "AponiaApplicationOptions.plugins",
      "file_type": "rationale",
      "rationale": "Whole-plugin mount on the root application before module-graph plugins for dynamic call-built plugins that compileRootModule and static descriptor builds cannot lower as module imports.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_native_route",
      "label": "routing/native-route.ts Single Route Registration Seam",
      "file_type": "concept",
      "rationale": "Isolates Elysia route() and all() calls so API changes fail cleanly as UNSUPPORTED_ELYSIA_VERSION and maps ALL to .all() because Elysia router answers 404 for route('ALL', ...).",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_route_uniqueness",
      "label": "Route Uniqueness Check (DUPLICATE_ROUTE)",
      "file_type": "concept",
      "rationale": "Prevents mount-order-dependent routing in Elysia by rejecting duplicate (method, path) declarations across reachable modules during compileRootModule.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_execution_context_fork",
      "label": "Per-Request ExecutionContext Fork",
      "file_type": "rationale",
      "rationale": "Compiles one immutable route prototype and calls fork(context) per hook invocation so overlapping async requests cannot overwrite shared context.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_app_enhancer_tokens",
      "label": "Global Enhancer Tokens (APP_GUARD, APP_INTERCEPTOR, APP_FILTER, APP_PIPE)",
      "file_type": "concept",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_request_scoped_controller",
      "label": "Request-Scoped Controllers and Enhancers",
      "file_type": "rationale",
      "rationale": "Constructed once per request via instance resolver (or per socket for gateways); callbacks, message patterns, and generated invokers refuse request-scoped controllers because they close over one instance.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_default_exception_filter",
      "label": "Default Problem Details Exception Mapping and reportThroughLogger",
      "file_type": "rationale",
      "rationale": "Compiled last into each route's local error array rather than on the root Elysia app because Elysia root hooks outrank route filters; declines Elysia native responses and guards failure logging via reportThroughLogger.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_health_probes",
      "label": "Health Probes (compileHealthProbes and ApplicationReadiness)",
      "file_type": "concept",
      "rationale": "Hookless IETF health+json endpoints so orchestrators need no auth; markShuttingDown flips readiness to 503 fail before shutdown hooks start while liveness stays pass.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_shutdown_signals",
      "label": "Opt-in Shutdown Signal Handling (installShutdownSignalHandlers)",
      "file_type": "concept",
      "rationale": "Installed only after listen({ shutdownSignals: true }) so building an app without listening never hijacks process signals; removes listeners synchronously and re-raises signal via kill to preserve exit status.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_sucrose_invoker_compilation",
      "label": "Sucrose-Compatible Route Invoker Compilation",
      "file_type": "rationale",
      "rationale": "Elysia sucrose statically analyzes handler source, so invokers expose used context fields directly and use handler.call(instance, ...); handlers stay Promise-capable unless design:returntype proves sync return.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_invoker_artifact",
      "label": "Build-Time Invoker Artifact (routing/invoker-artifact.ts)",
      "file_type": "concept",
      "rationale": "Refuses version-mismatched artifacts gracefully by falling back to decorator compilation so stale artifacts only cost cold-start work rather than boot failure.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "packages_platform_elysia_agents_descriptor_artifact",
      "label": "Build-Time Module Descriptor Artifact (module-descriptor-artifact.ts)",
      "file_type": "concept",
      "rationale": "Adopted whole for the module graph when stamped with matching release and root class name (guarded by isModuleDefinition); falls back to decorator lowering otherwise.",
      "source_file": "packages/platform-elysia/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },

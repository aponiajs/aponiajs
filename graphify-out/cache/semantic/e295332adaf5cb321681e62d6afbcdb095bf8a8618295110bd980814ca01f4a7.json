    {
      "id": "packages_core_agents_eager_graph_compilation",
      "label": "Eager Module Graph Compilation",
      "file_type": "rationale",
      "source_file": "packages/core/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "compileModuleGraph validates module identity (instanceId ?? id), import cycles, duplicate tokens, unknown provider shapes, unresolvable exports, and missing dependencies before any instance exists."
    },
    {
      "id": "packages_core_agents_module_visibility_rules",
      "label": "Module Encapsulation and Diamond Resolution",
      "file_type": "concept",
      "source_file": "packages/core/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "ModuleGraph.locate checks own providers, then exporting imports, then predefined tokens; unexported providers are hidden, conflicting imports throw AMBIGUOUS_PROVIDER, and diamond re-exports of one shared provider agree."
    },

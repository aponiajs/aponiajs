    {
      "id": "packages_microservices_agents_no_provisioning_invariant",
      "label": "Zero Infrastructure Provisioning Invariant",
      "file_type": "rationale",
      "rationale": "The framework provisions no topics, queues, exchanges, subscriptions, or dead-letter resources; reply destinations and server allowlists are exact operator configuration.",
      "source_file": "packages/microservices/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,

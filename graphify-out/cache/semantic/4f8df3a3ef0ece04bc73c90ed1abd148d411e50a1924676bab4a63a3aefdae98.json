    },
    {
      "id": "packages_microservices_agents_sanitized_errors_invariant",
      "label": "Sanitized Adapter Errors & Delivery Guarantees",
      "file_type": "rationale",
      "rationale": "Errors carry stable code, transport name, operation, and package name without leaking connection strings, credentials, topics, or payloads; no delivery claim beyond the protocol is made.",

{
  "name": "aponiajs-workspace",
  "private": true,
  "description": "Bun-first application architecture powered by Elysia.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "dev": "bun run --filter aponiajs dev",
    "example:basic": "bun run --cwd examples/basic-foundation start",
    "test": "bun run --workspaces test",
    "test:vite-plus": "vp test",
    "check": "vp check",
    "release:dry-run": "for package in common core platform-elysia cli create-aponia; do bun pm pack --cwd packages/$package --dry-run; done",
    "prepare": "bunx --bun vp config"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.3.14"
}

{
  "name": "aponiajs-workspace",
  "version": "0.3.3",
  "private": true,
  "description": "Bun-first application architecture powered by Elysia.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "benchmark:elysia": "bun run build && bun run benchmark:elysia:run",
    "benchmark:elysia:run": "bun benchmarks/elysia-overhead/benchmark.ts",
    "build": "bun run --workspaces build",
    "dev": "bun run --filter aponiajs dev",
    "example:basic": "bun run --cwd examples/basic-foundation start",
    "test": "bun run --workspaces test",
    "test:vite-plus": "vp test",
    "check": "vp check",
    "doctor": "vp env doctor",
    "version:bump": "bumpp package.json packages/aponiajs/package.json packages/cli/package.json packages/common/package.json packages/core/package.json packages/create-aponia/package.json packages/platform-elysia/package.json --all --no-commit --no-tag --no-push --execute \"bun run version:sync\"",
    "version:patch": "bun run version:bump -- --release patch --yes",
    "version:minor": "bun run version:bump -- --release minor --yes",
    "version:major": "bun run version:bump -- --release major --yes",
    "version:sync": "bun install --lockfile-only && bun run release:verify",
    "release:verify": "bun scripts/verify-release.ts",
    "release:dry-run": "for package in common core platform-elysia cli create-aponia; do bun pm pack --cwd packages/$package --dry-run; done",
    "prepare": "bunx --bun vp config"
  },
  "devDependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@types/bun": "^1.3.14",
    "bumpp": "^11.1.0",
    "elysia": "^1.4.29",
    "tinybench": "^6.1.2",
    "typescript": "^7.0.2",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.3.14"
}

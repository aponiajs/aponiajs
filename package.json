{
  "name": "aponiajs-workspace",
  "version": "1.0.0-beta.22",
  "private": true,
  "description": "Bun-first application architecture powered by Elysia.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "dev": "bun run --filter aponiajs dev",
    "example:basic": "bun run --cwd examples/basic start",
    "example:configuration": "bun run --cwd examples/configuration start",
    "example:dependency-injection": "bun run --cwd examples/dependency-injection start",
    "example:descriptors": "bun run --cwd examples/descriptors start",
    "example:devtools": "bun run --cwd examples/devtools start",
    "example:files": "bun run --cwd examples/files start",
    "example:lifecycle": "bun run --cwd examples/lifecycle start",
    "example:multiple-routers": "bun run --cwd examples/multiple-routers start",
    "example:native-plugins": "bun run --cwd examples/native-plugins start",
    "example:request-parameters": "bun run --cwd examples/request-parameters start",
    "example:validation": "bun run --cwd examples/validation start",
    "example:websockets": "bun run --cwd examples/websockets start",
    "test": "bun run --workspaces test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/coverage-gate.ts",
    "test:examples": "bun test ./examples/*/test/*.e2e-spec.ts",
    "test:generated-app": "bun test ./packages/cli/e2e/generated-application.e2e.ts",
    "test:vite-plus": "vp test",
    "check": "vp check",
    "doctor": "vp env doctor",
    "version:bump": "bumpp package.json packages/aponiajs/package.json packages/cli/package.json packages/common/package.json packages/core/package.json packages/cors/package.json packages/create-aponia/package.json packages/cron/package.json packages/devtools/package.json packages/graphql/package.json packages/mcp/package.json packages/openapi/package.json packages/opentelemetry/package.json packages/platform-elysia/package.json packages/testing/package.json --all --no-commit --no-tag --no-push --execute \"bun run version:sync\"",
    "version:patch": "bun run version:bump -- --release patch --yes",
    "version:minor": "bun run version:bump -- --release minor --yes",
    "version:major": "bun run version:bump -- --release major --yes",
    "version:alpha": "bun run version:bump -- --release prerelease --preid alpha --yes",
    "version:beta": "bun run version:bump -- --release prerelease --preid beta --yes",
    "version:rc": "bun run version:bump -- --release prerelease --preid rc --yes",
    "version:promote": "bun run version:bump -- --release patch --yes",
    "version:sync": "bun scripts/sync-version-references.ts && bun install --lockfile-only && bun run release:verify",
    "release:verify": "bun scripts/verify-release.ts",
    "release:tag": "bun scripts/distribution-tag.ts",
    "release:branch": "bun scripts/release-branch.ts",
    "release:canary": "bun scripts/canary-version.ts",
    "release:dry-run": "for package in common core platform-elysia cli create-aponia devtools cron cors graphql mcp testing openapi opentelemetry; do bun pm pack --cwd packages/$package --dry-run; done",
    "prepare": "bunx --bun vp config"
  },
  "devDependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@types/bun": "^1.4.2",
    "bumpp": "^12.3.0",
    "elysia": "2.0.0-beta.19",
    "jsonc-parser": "^3.3.1",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "^0.2.9"
  },
  "overrides": {
    "@graphql-tools/utils": "^12.0.3",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "exact-mirror": "^1.2.6",
    "protobufjs": "8.8.0",
    "source-map-js": "^1.2.2",
    "tinypool": "^2.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.2"
}

{
  "name": "@aponiajs/http",
  "version": "1.0.0-beta.36",
  "description": "SSRF-safe outbound HTTP for an Aponia application, with timeouts, bounded responses, and validation.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "fetch",
    "http",
    "ssrf",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/http"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "ipaddr.js": "^2.2.0"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "zod": "^4.6.6"
  }
}

{
  "name": "@aponiajs/config",
  "version": "1.0.0-beta.64",
  "description": "Configuration module for AponiaJS with .env loading, variable expansion, namespaces, and schema validation.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "config",
    "env",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/cli": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "elysia": "2.0.0-rc.5",
    "typebox": "^1.4.7",
    "zod": "^4.6.6"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

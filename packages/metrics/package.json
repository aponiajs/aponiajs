{
  "name": "@aponiajs/metrics",
  "version": "1.0.0-beta.62",
  "description": "Prometheus metrics for an Aponia application: a bounded registry, request instrumentation, and a scrape endpoint.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "metrics",
    "observability",
    "prometheus"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/metrics"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-core": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "@aponiajs/platform-h3": "workspace:*",
    "@aponiajs/platform-hono": "workspace:*",
    "@aponiajs/serverless": "workspace:*",
    "elysia": "2.0.0-rc.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

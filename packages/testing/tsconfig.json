{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["bun"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@aponiajs/view": ["../view/src/index.ts"],
      "@aponiajs/tenancy": ["../tenancy/src/index.ts"],
      "@aponiajs/store-redis": ["../store-redis/src/index.ts"],
      "@aponiajs/session": ["../session/src/index.ts"],
      "@aponiajs/serverless": ["../serverless/src/index.ts"],
      "@aponiajs/security": ["../security/src/index.ts"],
      "@aponiajs/rate-limit": ["../rate-limit/src/index.ts"],
      "@aponiajs/queue": ["../queue/src/index.ts"],
      "@aponiajs/platform-h3": ["../platform-h3/src/index.ts"],
      "@aponiajs/opentelemetry": ["../opentelemetry/src/index.ts"],
      "@aponiajs/openapi": ["../openapi/src/index.ts"],
      "@aponiajs/nitro": ["../nitro/src/index.ts"],
      "@aponiajs/microservices": ["../microservices/src/index.ts"],
      "@aponiajs/metrics": ["../metrics/src/index.ts"],
      "@aponiajs/mcp": ["../mcp/src/index.ts"],
      "@aponiajs/idempotency": ["../idempotency/src/index.ts"],
      "@aponiajs/http": ["../http/src/index.ts"],
      "@aponiajs/hono": ["../hono/src/index.ts"],
      "@aponiajs/h3": ["../h3/src/index.ts"],
      "@aponiajs/graphql": ["../graphql/src/index.ts"],
      "@aponiajs/events": ["../events/src/index.ts"],
      "@aponiajs/devtools": ["../devtools/src/index.ts"],
      "@aponiajs/database": ["../database/src/index.ts"],
      "@aponiajs/cron": ["../cron/src/index.ts"],
      "@aponiajs/cors": ["../cors/src/index.ts"],
      "@aponiajs/compression": ["../compression/src/index.ts"],
      "@aponiajs/compiler": ["../compiler/src/index.ts"],
      "@aponiajs/cli": ["../cli/src/index.ts"],
      "@aponiajs/cache": ["../cache/src/index.ts"],
      "@aponiajs/auth": ["../auth/src/index.ts"],
      "@aponiajs/audit": ["../audit/src/index.ts"],
      "@aponiajs/testing": ["./src/index.ts"],
      "@aponiajs/common": ["../common/src/index.ts"],
      "@aponiajs/core": ["../core/src/index.ts"],
      "@aponiajs/platform-elysia": ["../platform-elysia/src/index.ts"],
      "@aponiajs/platform-hono": ["../platform-hono/src/index.ts"],
      "@aponiajs/platform-core": ["../platform-core/src/index.ts"]
    }
  }
}

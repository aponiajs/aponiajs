{
  "name": "@aponiajs/testing",
  "version": "1.0.0-beta.24",
  "description": "Boot an Aponia application for a test, with provider overrides and a teardown a case can rely on.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "dependency-injection",
    "elysia",
    "mocks",
    "test-utils",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*"
  },
  "devDependencies": {
    "elysia": "2.0.0-beta.24"
  },
  "peerDependencies": {
    "elysia": "2.0.0-beta.24"
  }
}

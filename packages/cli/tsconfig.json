{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "paths": {
      "@aponiajs/common": ["../common/src/index.ts"],
      "@aponiajs/core": ["../core/src/index.ts"],
      "@aponiajs/platform-elysia": ["../platform-elysia/src/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}

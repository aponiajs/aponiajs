import { Logger } from "@aponiajs/common";

/**
 * The application's logger, held here because two places take the same object.
 *
 * `AponiaFactory.create` writes every bootstrap line — the modules it
 * initialized, the routes it resolved — through the logger it is handed, and
 * `devtoolsPlugin` patches the logger it is handed in place so
 * `/__devtools/logs` can serve those lines. One object handed to both is what
 * makes that stream carry the boot's own output; a logger that reached only one
 * of them would leave the other with nothing to record or nothing to record
 * from.
 *
 * Pass this to `devtoolsPlugin` only if you also pass it to
 * `AponiaFactory.create`, and the other way round. Replace it with your own
 * `LoggerService` when the application should log somewhere else.
 */
export const appLogger = new Logger("App");

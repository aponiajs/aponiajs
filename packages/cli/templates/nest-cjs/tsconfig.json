{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "moduleDetection": "force",
    "types": ["bun", "jest"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}

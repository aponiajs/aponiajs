{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["bun"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@aponiajs/common": ["../common/src/index.ts"],
      "@aponiajs/core": ["../core/src/index.ts"],
      "@aponiajs/serverless": ["../serverless/src/index.ts"],
      "@aponiajs/platform-elysia": ["../platform-elysia/src/index.ts"],
      "@aponiajs/view": ["../view/src/index.ts"],
      "@aponiajs/h3": ["../h3/src/index.ts"],
      "@aponiajs/hono": ["../hono/src/index.ts"],
      "@aponiajs/nitro": ["../nitro/src/index.ts"]
    }
  }
}

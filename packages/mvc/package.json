{
  "name": "@aponiajs/mvc",
  "version": "1.0.0-beta.27",
  "description": "Universal multi-engine and SSR framework bridges for Next.js, Nuxt.js, Angular, Express, and Fastify in AponiaJS.",
  "keywords": [
    "angular",
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "express",
    "fastify",
    "mvc",
    "nextjs",
    "nuxtjs",
    "ssr",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/mvc"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/serverless": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "@aponiajs/h3": "workspace:*",
    "@aponiajs/hono": "workspace:*",
    "@aponiajs/nitro": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@aponiajs/view": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "h3": "^2.0.8",
    "hono": "^4.13.17",
    "nitro": "3.0.261103-rc"
  }
}

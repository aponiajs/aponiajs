{
  "name": "@aponiajs/store-redis",
  "version": "1.0.0-beta.40",
  "description": "Redis storage adapters for AponiaJS cache, rate-limit, session, idempotency, and auth token stores.",
  "keywords": [
    "aponia",
    "aponiajs",
    "auth",
    "bun",
    "cache",
    "distributed",
    "idempotency",
    "rate-limit",
    "redis",
    "session",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/store-redis"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/auth": "workspace:*",
    "@aponiajs/cache": "workspace:*",
    "@aponiajs/core": "workspace:*",
    "@aponiajs/idempotency": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@aponiajs/rate-limit": "workspace:*",
    "@aponiajs/session": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "redis": "6.3.1"
  },
  "peerDependencies": {
    "redis": "6.3.1"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

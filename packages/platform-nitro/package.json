{
  "name": "@aponiajs/platform-nitro",
  "version": "1.0.0-beta.59",
  "description": "AponiaJS on Nitro: the H3 platform's host as a Nitro server handler.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "nitro",
    "platform",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/platform-nitro"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-core": "workspace:*",
    "@aponiajs/platform-h3": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "h3": "^2.0.8",
    "nitro": "3.0.261103-rc"
  },
  "peerDependencies": {
    "h3": "^2.0.8",
    "nitro": "3.0.261103-rc"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    },
    "nitro": {
      "optional": false
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

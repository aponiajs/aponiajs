{
  "name": "@aponiajs/nitro",
  "version": "1.0.0-beta.30",
  "description": "Nitro delivery adapter for an Aponia application.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "nitro"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/nitro"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/serverless": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "nitro": "3.0.261103-rc"
  },
  "peerDependencies": {
    "nitro": "3.0.261103-rc"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": false
    }
  }
}

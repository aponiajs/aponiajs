{
  "name": "@aponiajs/database",
  "version": "1.0.0-beta.37",
  "description": "A Drizzle-first database boundary for an Aponia application: transactions, typed repositories, and ordered SQL migrations.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "database",
    "drizzle",
    "elysia",
    "migrations",
    "repository"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/database"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@types/pg": "^8.23.1",
    "elysia": "2.0.0-rc.4",
    "pg": "^8.23.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

{
  "name": "@aponiajs/mapped-types",
  "version": "1.0.0",
  "description": "Mapped DTO type helpers (PartialType, PickType, OmitType, IntersectionType) for AponiaJS validation models.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "dto",
    "mapped-types",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/mapped-types"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@aponiajs/cli": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "elysia": "2.0.0-rc.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

{
  "name": "@aponiajs/platform-elysia",
  "version": "1.0.0-beta.6",
  "description": "Elysia application platform for Aponia HTTP controllers and WebSocket gateways.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "dependency-injection",
    "elysia",
    "http",
    "rest-api",
    "routing",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/platform-elysia"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/core": "workspace:*"
  },
  "devDependencies": {
    "@elysia/eden": "2.0.0-beta.5",
    "arktype": "^2.2.3",
    "elysia": "2.0.0-beta.19",
    "typebox": "^1.3.34",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "elysia": "2.0.0-beta.19",
    "typebox": "^1.3.0"
  }
}

{
  "name": "@aponiajs/opentelemetry",
  "version": "1.0.0-beta.64",
  "description": "Trace an Aponia application's routes with OpenTelemetry, with the policy read from a validated configuration.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "opentelemetry",
    "otel",
    "tracing",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/opentelemetry"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-core": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1"
  },
  "devDependencies": {
    "@aponiajs/cli": "workspace:*",
    "@aponiajs/platform-core": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@aponiajs/platform-h3": "workspace:*",
    "@aponiajs/platform-hono": "workspace:*",
    "@aponiajs/serverless": "workspace:*",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "elysia": "2.0.0-rc.4",
    "zod": "^4.6.6"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

{
  "name": "@aponiajs/opentelemetry",
  "version": "1.0.0-beta.64",
  "description": "Opt-in OpenTelemetry distributed tracing, W3C traceparent propagation, and span lifecycle for an Aponia application.",
  "keywords": [
    "aponia",
    "aponiajs",
    "bun",
    "observability",
    "opentelemetry",
    "tracing",
    "typescript"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/opentelemetry"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@aponiajs/platform-h3": "workspace:*",
    "@aponiajs/platform-hono": "workspace:*",
    "@aponiajs/testing": "workspace:*",
    "elysia": "2.0.0-rc.5"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

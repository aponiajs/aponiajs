{
  "name": "@aponiajs/mcp",
  "version": "1.0.0-beta.61",
  "description": "Model Context Protocol endpoint for AponiaJS, mounted from the official SDK server as a module registration.",
  "keywords": [
    "agents",
    "ai",
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "llm",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "elysia": "2.0.0-rc.4",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "elysia": "2.0.0-rc.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

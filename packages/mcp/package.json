{
  "name": "@aponiajs/mcp",
  "version": "1.0.0-beta.61",
  "description": "Nest-style Model Context Protocol server for AponiaJS, with decorated tools, resources, and prompts served from the official SDK.",
  "keywords": [
    "agents",
    "ai",
    "aponia",
    "aponiajs",
    "bun",
    "elysia",
    "llm",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "llms.txt",
    "aponia.library.json"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*",
    "@aponiajs/platform-core": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@aponiajs/platform-elysia": "workspace:*",
    "@aponiajs/platform-h3": "workspace:*",
    "@aponiajs/platform-hono": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "h3": "^2.0.8",
    "hono": "^4.13.17",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "elysia": "2.0.0-rc.4",
    "h3": "^2.0.8",
    "hono": "^4.13.17",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}

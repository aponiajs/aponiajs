{
  "contractVersion": 1,
  "name": "@aponiajs/mcp",
  "kind": "plugin",
  "platforms": ["elysia", "hono", "h3"],
  "framework": {
    "aponia": "1.0.0-beta.63",
    "bun": ">=1.4.4"
  },
  "entrypoints": [
    {
      "subpath": ".",
      "module": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  ],
  "provides": [
    {
      "kind": "module",
      "token": "McpModule"
    },
    {
      "kind": "provider",
      "token": "McpExecutionContext"
    },
    {
      "kind": "provider",
      "token": "Tool"
    }
  ],
  "requires": [],
  "security": {
    "network": false,
    "filesystem": false,
    "postinstall": false,
    "permissions": []
  }
}

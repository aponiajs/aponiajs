{
  "name": "@aponiajs/compiler",
  "version": "1.0.0-beta.64",
  "description": "Compiler-grade invariants for an Aponia application: scoped lifetimes, exclusive mutation, typestate, and linear consumption.",
  "keywords": [
    "aponia",
    "aponiajs",
    "borrow",
    "bun",
    "compiler",
    "lifetime",
    "typestate"
  ],
  "homepage": "https://github.com/aponiajs/aponiajs#readme",
  "bugs": {
    "url": "https://github.com/aponiajs/aponiajs/issues"
  },
  "license": "MIT",
  "author": "AponiaJS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aponiajs/aponiajs.git",
    "directory": "packages/compiler"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun vp pack",
    "dev": "bunx --bun vp pack --watch",
    "test": "bun test",
    "test:vite-plus": "vp test",
    "check": "bunx --bun vp check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aponiajs/common": "workspace:*"
  },
  "devDependencies": {
    "@aponiajs/core": "workspace:*",
    "@aponiajs/platform-elysia": "workspace:*",
    "@aponiajs/platform-h3": "workspace:*",
    "@aponiajs/platform-hono": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "h3": "^2.0.8",
    "hono": "^4.13.17"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
